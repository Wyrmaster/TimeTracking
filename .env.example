# Copy this file to .env and fill in the values, the .env file is ignored by git.
# It is read by docker compose and, while developing, by the service itself on startup.

# Symmetric key signing the login tokens, at least 64 random bytes, e.g. generated with:
#   openssl rand -hex 64
TokenSecret=

# Password of the postgres container started by docker compose
POSTGRES_PASSWORD=

# Database used when running the service locally (docker compose sets its own connection string)
ConnectionStrings__TimeTrackingPostgresql=User ID=postgres;Password=;Host=localhost;Port=5432;Database=TimeTracking;
