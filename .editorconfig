root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
max_line_length = 120

# braces on their own line, else / catch / finally start a new line
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# explicit types and this. qualification, as used throughout the solution
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_qualification_for_field = true:suggestion
dotnet_style_qualification_for_method = true:suggestion

# one chained call per line (Rider / ReSharper)
resharper_wrap_chained_method_calls = chop_always
resharper_keep_existing_linebreaks = true
resharper_place_simple_embedded_statement_on_same_line = false

[*.{ts,tsx,js,jsx,json,scss,css}]
max_line_length = 120
quote_type = single
